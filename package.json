{
  "name": "salmon-api",
  "version": "0.15.2",
  "description": "Salmon API",
  "main": "index.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "test": "jest --detectOpenHandles",
    "test:unit": "jest --testPathPatterns='.spec.js$' --testPathIgnorePatterns='integration.spec.js' --detectOpenHandles",
    "test:integration": "jest --testPathPatterns='integration.spec.js$' --detectOpenHandles --runInBand",
    "test:helius": "jest --testPathPatterns='helius.*\\.spec\\.js$' --detectOpenHandles",
    "test:watch": "jest --watch --detectOpenHandles",
    "test:coverage": "jest --coverage --detectOpenHandles",
    "linter": "eslint ./ --fix",
    "lint:check": "eslint ./ --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:integration:hermetic": "jest --testPathPatterns='packages/redis-connector/index.integration.spec.js' --detectOpenHandles --runInBand",
    "serverless:start:local": "serverless offline --stage local --disableCookieValidation",
    "serverless:print": "serverless print --stage prod -v",
    "serverless:build": "serverless package --stage prod",
    "serverless:deploy": "serverless deploy --stage prod"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Salmon-HQ/salmon-wallet-backend.git"
  },
  "author": "GeekOcean Labs Ltd",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/Salmon-HQ/salmon-wallet-backend/issues"
  },
  "homepage": "https://github.com/Salmon-HQ/salmon-wallet-backend#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "dotenv": "^17.4.2",
    "eslint": "^10.9.0",
    "jest": "^30.4.2",
    "prettier": "^3.9.6",
    "serverless": "^3",
    "serverless-api-gateway-throttling": "^2.0.3",
    "serverless-dotenv-plugin": "^4",
    "serverless-import-config-plugin": "^0.1.3",
    "serverless-offline": "^13.10.1",
    "serverless-plugin-warmup": "^8.4.1"
  },
  "dependencies": {
    "@metaplex-foundation/digital-asset-standard-api": "^2.0.0",
    "@metaplex-foundation/mpl-bubblegum": "^5.1.0",
    "@metaplex-foundation/mpl-token-metadata": "^3.4.0",
    "@metaplex-foundation/umi": "^1.5.1",
    "@metaplex-foundation/umi-bundle-defaults": "^1.5.1",
    "@metaplex-foundation/umi-web3js-adapters": "^1.4.1",
    "@solana/spl-token": "^0.4.15",
    "@solana/spl-token-registry": "^0.2.3551",
    "@solana/web3.js": "^1.98.4",
    "axios": "^1.19.0",
    "bn.js": "^5.2.5",
    "bs58": "^6.0.0",
    "buffer-layout": "^1.2.2",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-validator": "^7.3.2",
    "js-yaml": "^4.1.0",
    "lodash": "^4.17.21",
    "qs": "^6.15.3",
    "redis": "^5.10.0",
    "serverless-http": "^4.0.0",
    "ua-parser-js": "^2.0.10"
  }
}
