# ===== Runtime =====
# Node environment. `development` locally (docker/serverless-offline); the deploy sets `production`.
NODE_ENV=
# Host port for serverless-offline's HTTP API in docker-compose (default 3000). Routes are prefixed with the stage: http://127.0.0.1:<port>/local/...
OFFLINE_HTTP_PORT=
# Host port for serverless-offline's Lambda invoke endpoint (default 3002).
OFFLINE_LAMBDA_PORT=
# Host port mapped to the docker-compose redis service (default 6379). Only matters when several checkouts run side by side (e.g. Conductor).
# CONDUCTOR_REDIS_PORT=

# ===== Redis (cache, shared rate limiter, circuit breaker state) =====
# Redis hostname. `redis` inside docker-compose, `localhost` when the API runs on the host. Prod uses Redis Cloud.
REDIS_HOST=
# Redis port (6379; use the mapped host port when connecting from outside docker).
REDIS_PORT=
# Milliseconds to wait for the initial Redis connection before giving up.
REDIS_CONNECT_TIMEOUT=
# How many reconnect attempts before the client stops trying (cache then degrades to no-cache).
REDIS_RECONNECT_MAX_RETRIES=
# Milliseconds during which, after a failed connection, cache reads/writes are skipped instead of waiting.
REDIS_FAIL_FAST_LAPSE=
# Redis AUTH password. Empty for the local docker instance.
REDIS_PASSWORD=

# ===== Solana data providers =====
# Triton One mainnet endpoint (RPC + DAS): enriched transaction history, token metadata, Token-2022 extensions. Paste the full URL with the token embedded: https://<tenant>.solana-mainnet.rpcpool.com/<token>
TRITON_RPC_URL=
# Triton One devnet endpoint, same format as TRITON_RPC_URL.
TRITON_RPC_URL_DEVNET=
# Only when TRITON_RPC_URL is a bare rpcpool.com host: the token is appended as a path segment. Most setups embed it in the URL and leave this unset.
# TRITON_API_TOKEN=
# Helius API key. Fallback provider for enriched transactions when Triton errors or is rate limited.
HELIUS_API_KEY=
# `paid` widens the Helius rate profile; unset = free tier (10 req/s, burst 20).
# HELIUS_TIER=
# Cap on Helius fallback traffic in requests/second (default 8) so a Triton outage cannot burn the free Helius quota.
SOLANA_FALLBACK_MAX_RPS=
# Test-only: RPC used by the nightly token-data integration spec (default: public mainnet RPC).
# SOLANA_MAINNET_RPC_URL=
# Test-only: solana-test-validator URL for the local-validator suites (default http://127.0.0.1:8899).
# SOLANA_LOCAL_RPC_URL=
# Blockdaemon Universal API key: primary source for Solana and Bitcoin account balances, Bitcoin history and UTXOs.
UBIQUITY_API_KEY=

# ===== Powerups (unsigned transaction builds) =====
# Compute-unit price prepended to every Powerup build. Unset = dynamic (p75 of recent network fees, clamped 1000-20000, over a simulated CU limit); a number pins it; 0 disables the priority-fee instruction.
POWERUP_PRIORITY_FEE_MICROLAMPORTS=

# ===== CoinGecko (token catalog + search, USD prices, charts, exchange rates) =====
# CoinGecko API key. Demo key works for development; a paid plan (Basic or higher) is required for a fee-earning app.
COINGECKO_API_KEY=
# Empty for a Demo key (api.coingecko.com, header x-cg-demo-api-key). Paid plans: https://pro-api.coingecko.com (header x-cg-pro-api-key).
COINGECKO_API_URL=

# ===== Provider resilience (src/infrastructure/providers) =====
# Time budget per request that every provider wait, timeout and retry stops at (default 25000; API Gateway cuts at 29 s).
# REQUEST_BUDGET_MS=
# `true` bypasses the per-provider circuit breaker (useful locally against flaky sandboxes). Never set in prod.
# BREAKER_DISABLED=
# `true` silences the CloudWatch EMF metric lines (namespace SalmonApi/Providers) to avoid custom-metric costs; the JSON lines still reach the logs. Prod is `true` until Linear DEV-52.
# METRICS_DISABLED=
# Override CoinGecko's shared sustained rate (requests/second). Unset = profile default for the detected plan.
# COINGECKO_MAX_RPS=
# Override Helius' shared sustained rate (requests/second). Unset = profile default.
# HELIUS_MAX_RPS=
# Override Triton's shared sustained rate (requests/second). Unset = profile default (well under the 1200 req/10 s plan limit).
# TRITON_MAX_RPS=
# Override Blockdaemon's shared sustained rate (requests/second). Unset = profile default.
# BLOCKDAEMON_MAX_RPS=
# Override the outbound rate for dapp metadata fetches (requests/second). Unset = profile default.
# DAPP_MAX_RPS=

# ===== Per-IP rate limiting (src/index.js) =====
# `log` counts over-limit requests without blocking (default); `enforce` answers 429.
RATE_LIMIT_MODE=
# Requests allowed per IP per window on regular endpoints (default 300).
RATE_LIMIT_MAX=
# Requests allowed per IP per window on transaction-building endpoints (/nft, /powerups) (default 30).
RATE_LIMIT_TX_MAX=
# Length of the rate-limit window in seconds (default 60).
RATE_LIMIT_WINDOW_SECONDS=

# ===== Ethereum (scaffold only, not surfaced to the wallet) =====
# Overrides the default Ethereum mainnet RPC (https://eth.llamarpc.com).
# ETHEREUM_MAINNET_RPC_URL=
# Overrides the default Sepolia RPC (https://rpc.sepolia.org).
# ETHEREUM_SEPOLIA_RPC_URL=

# ===== Anonymous usage analytics (POST /v1/events, see docs/ANALYTICS.md) =====
# Where opt-in, PII-free events go: `file` (default; NDJSON on disk, no external calls) or `ga4` (Google Analytics 4 Measurement Protocol).
ANALYTICS_SINK=
# NDJSON path for ANALYTICS_SINK=file (default ./analytics-events.ndjson).
# ANALYTICS_FILE_PATH=
# GA4 web stream Measurement ID (G-XXXXXXXXXX). Only for ANALYTICS_SINK=ga4.
# GA4_MEASUREMENT_ID=
# GA4 Measurement Protocol API secret. Server-side only: never in the client, never committed.
# GA4_API_SECRET=
