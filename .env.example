NODE_ENV=

OFFLINE_HTTP_PORT=
OFFLINE_LAMBDA_PORT=
# Host port for the docker-compose redis service (docker-compose.yml). Optional;
# only matters when running several checkouts side by side (e.g. Conductor).
# CONDUCTOR_REDIS_PORT=6380

REDIS_HOST=
REDIS_PORT=
REDIS_CONNECT_TIMEOUT=
REDIS_RECONNECT_MAX_RETRIES=
REDIS_FAIL_FAST_LAPSE=
REDIS_PASSWORD=

# Jupiter - Price v3 + Tokens v2 (balance pricing, token catalog/search)
JUPITER_PRICE_URL=
JUPITER_API_KEY=

# 0x Solana Swap API (https://dashboard.0x.org) - builds the UNSIGNED swap tx.
# ZEROEX_API_URL defaults to https://api.0x.org/solana. ZEROEX_MAX_RPS defaults to 2 (free tier 429s above that).
ZEROEX_API_URL=
ZEROEX_API_KEY=
# Comma-separated DEX labels (GET /enabled-sources) to exclude from routing, e.g. PumpFun,PumpSwap
ZEROEX_DISABLED_SOURCES=
# Salmon swap fee, paid to SWAP_FEE_ACCOUNT_OWNER's token account for the fee mint
# (the wallet itself for native SOL). Output token if that account exists, else the
# input token, else the swap goes out fee-less with a [SWAP_FEE_SKIPPED] error log.
# Both unset = no fee. Keep owner ATAs for SOL (none needed), USDC and USDT.
SWAP_FEE_BPS=
SWAP_FEE_ACCOUNT_OWNER=
# Priority fee (micro-lamports per compute unit). Unset = dynamic from the network
# (p75 of recent fees, clamped 1000-20000, with a simulated CU limit); a number pins it; 0 disables.
SWAP_PRIORITY_FEE_MICROLAMPORTS=

# Per-IP rate limiting (src/index.js). MODE=log counts without blocking (default);
# MODE=enforce blocks over-limit requests. Limits are per RATE_LIMIT_WINDOW_SECONDS.
RATE_LIMIT_MODE=log
RATE_LIMIT_MAX=300
RATE_LIMIT_TX_MAX=30
RATE_LIMIT_WINDOW_SECONDS=60

# Solana data providers
# Triton One — primary provider (RPC + DAS). Get credentials at https://triton.one/
# Paste the full endpoint with the token already embedded as a path segment:
#   https://<tenant>.solana-mainnet.rpcpool.com/<token>
TRITON_RPC_URL=
TRITON_RPC_URL_DEVNET=
# Optional. Appended as a path segment when TRITON_RPC_URL is a bare rpcpool.com host.
# Most deployments embed the token in the URL and leave this unset.
# TRITON_API_TOKEN=

# Helius — fallback only (free tier). Triggered when Triton errors or hits limits.
HELIUS_API_KEY=
# Optional. Set to "paid" to widen Helius rate limits. Defaults to free tier (10 req/s burst 20).
# HELIUS_TIER=

# Caps Helius free-tier usage when Triton fails (req/s). Prevents overrun of free quota.
SOLANA_FALLBACK_MAX_RPS=

# Ethereum RPC overrides (optional). Defaults: https://eth.llamarpc.com / https://rpc.sepolia.org
# ETHEREUM_MAINNET_RPC_URL=
# ETHEREUM_SEPOLIA_RPC_URL=

COINGECKO_API_KEY=
UBIQUITY_API_KEY=

# --- Anonymous usage analytics (POST /v1/events) ---
# Sink for opt-in, PII-free usage events. See docs/ANALYTICS.md.
#   file (default) — append NDJSON locally (docker/tests), no external calls
#   ga4            — forward to Google Analytics 4 via the Measurement Protocol
# Empty defaults to the file sink.
ANALYTICS_SINK=
# Only used when ANALYTICS_SINK=ga4. Both come from the GA4 web console:
# Admin → Data Streams → your web stream → Measurement ID, and → Measurement
# Protocol API secrets → Create. GA4_API_SECRET is server-side only: it stays in
# this env (gitignored .env), never in the client, never committed.
# GA4_MEASUREMENT_ID=G-XXXXXXXXXX
# GA4_API_SECRET=
