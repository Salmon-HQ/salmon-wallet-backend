#!/bin/sh
# The fast gates, before a commit exists. CI runs the same ones and is what
# blocks a merge; this only brings the answer forward by a few minutes.
# Skip once with `git commit --no-verify`.
set -e

staged=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$staged" ] && exit 0

git diff --cached --name-only --diff-filter=ACMR -z |
  xargs -0 npx prettier --check --ignore-unknown

npm run -s check:hidden-unicode
npm run -s check:dead-code
npm run -s check:cycles
npm run -s check:duplication
